# OpenAI-compatible LLM endpoint. The provider is fully swappable via these
# three variables alone - no code changes needed.

# --- Development (Ollama, local) - active by default ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# --- Production (Groq) ---
# To switch to Groq, comment out the three Ollama lines above and uncomment
# these. Get a key at https://console.groq.com/keys - never commit it, only
# put it in your local .env (already gitignored).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-api-key-here
# LLM_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Ollama's native embeddings API (separate from LLM_BASE_URL so the
# embedding provider can be swapped independently later). This stays on
# Ollama for local dev regardless of which LLM_* provider is active above.
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
